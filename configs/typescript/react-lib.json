{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "moveUpPatterns": ["@povio/", "@/", "\\.{1,2}/", "#"],
        "moveDownPatterns": ["react-aria-components"]
      }
    ]
  }
}
