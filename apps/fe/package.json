{
  "name": "fe",
  "description": "A template project for Povio SPA projects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "zx scripts/execute.mjs dev",
    "build": "zx scripts/execute.mjs build",
    "clean": "rimraf .turbo out dist .tanstack src/openapi",
    "lint": "oxlint --type-aware . --fix",
    "lint:check": "oxlint --type-aware . --quiet",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsgo --noEmit",
    "generate": "zx scripts/execute.mjs generate",
    "script": "zx scripts/execute.mjs --",
    "openapi:gen": "openapi-codegen generate --prettier false",
    "openapi:check": "openapi-codegen check",
    "i18n:missing": "npx tsx scripts/i18n/find-missing-translations.ts"
  },
  "dependencies": {
    "@casl/ability": "^6.7.5",
    "@casl/react": "^5.0.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@internationalized/date": "^3.10.1",
    "@povio/resolve-config": "1.2.0",
    "@povio/ui": "^2.1.18",
    "@sentry/react": "^10.22.0",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/react-devtools": "^0.8.1",
    "@tanstack/react-query": "~5.85.9",
    "@tanstack/react-query-devtools": "~5.85.9",
    "@tanstack/react-router": "^1.136.8",
    "@tanstack/react-router-devtools": "^1.136.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-core": "^1.136.8",
    "@tanstack/router-plugin": "^1.136.8",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepmerge": "^4.3.1",
    "i18next": "^25.7.3",
    "loglevel": "^1.9.2",
    "luxon": "^3.7.2",
    "react": "^19.2.3",
    "react-aria": "^3.44.0",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.5.1",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.9",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@biomejs/biome": "2.3.11",
    "@povio/openapi-codegen-cli": "^1.2.11",
    "@tailwindcss/vite": "^4.1.18",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260105.1",
    "@vitejs/plugin-react": "^5.1.2",
    "code-inspector-plugin": "^1.2.10",
    "oxlint": "1.36.0",
    "oxlint-tsgolint": "0.10.1",
    "rimraf": "^6.1.2",
    "rolldown-vite": "^7.3.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-react-aria-components": "^2.0.1",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@latest",
