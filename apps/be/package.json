{
  "name": "be",
  "description": "Povio Orion Nest.js Framework",
  "private": true,
  "version": "4.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "setup": "zx scripts/execute.mjs local-setup",
    "stop": "docker compose --profile \"*\" down",
    "build": "zx scripts/execute.mjs build",
    "bootstrap": "zx scripts/execute.mjs bootstrap",
    "clean": "rimraf .turbo dist .tmp src/database/prisma/generated",
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug --watch",
    "start": "node dist/main",
    "lint": "oxlint --type-aware . --fix",
    "lint:check": "oxlint --type-aware . --quiet",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "zx scripts/execute.mjs test",
    "test:setup": "zx scripts/execute.mjs test-setup",
    "test:watch": "vitest -w",
    "test:unit": "vitest **/*.unit.ts",
    "test:e2e": "vitest **/*.e2e.ts",
    "script": "zx scripts/execute.mjs --",
    "check": "turbo run check:ci",
    "check:ci": "zx scripts/execute.mjs check",
    "generate": "zx scripts/execute.mjs generate",
    "scaffold": "npx @povio/scaffold@1.4.0",
    "docs": "zx scripts/execute.mjs docs",
    "openapi:export": "nest start --config src/common/http/openapi/openapi.tsc.nest-cli.json",
    "prisma": "npx prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.964.0",
