    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "rxjs": "^7.8.2",
    "serialize-error": "12.0.0",
    "short-uuid": "^6.0.3",
    "tsx": "^4.21.0",
    "yaml": "^2.8.2",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
