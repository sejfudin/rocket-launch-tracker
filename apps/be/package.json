    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/swagger": "^11.2.4",
    "@povio/resolve-config": "1.2.0",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "@tokenizer/s3": "^1.0.1",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cron-parser": "^5.4.0",
    "express": "^5.2.1",
    "file-type": "^21.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mime-types": "^3.0.2",
