          {
            "name": "order",
            "required": false,
            "in": "query",
            "description": "Order by fields (comma separated with +/- prefix): id, provider, expiresAt, createdAt",
            "x-enumNames": [
              "id",
              "provider",
              "expiresAt",
              "createdAt"
            ],
            "schema": {
              "example": "id",
              "type": "string"
            }
          },
          {
            "name": "filter",
            "required": false,
            "in": "query",
            "description": "Filter",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/PushNotificationTokenFiltersDto"
            }
          },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "description": "Items per response",
            "schema": {
              "minimum": 1,
              "maximum": 20,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "1-indexed page number to begin from",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "ID of item to start after",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginationDto"
                    },
                    {
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PushNotificationTokenResponse"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "summary": "Paginate push notification tokens",
        "tags": [
          "Push Notifications"
        ]
