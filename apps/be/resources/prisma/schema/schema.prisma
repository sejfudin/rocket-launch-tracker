generator client {
  provider        = "prisma-client"
  output          = "../../../src/database/prisma/generated"
  runtime         = "nodejs"
  moduleFormat    = "CommonJS"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email String?
  name  String?
  roles String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
