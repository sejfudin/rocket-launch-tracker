model PushNotificationTemplate {
  id String @id @default(uuid()) @db.Uuid

  name String  @unique

  title    String?
  body     String?
  imageUrl String?
  
  data Json?

  type String @default("custom")

  module      String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
