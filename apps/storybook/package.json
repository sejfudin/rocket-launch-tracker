    "@tiptap/starter-kit": "^2.26.3",
    "i18next": "^25.7.3",
    "react": "^19.2.3",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.1",
    "react-toastify": "^11.0.5",
    "storybook": "^10.1.11",
    "tailwindcss-react-aria-components": "^2.0.1",
    "zod": "^4.3.5"
