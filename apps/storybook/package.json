{
  "name": "storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "NODE_OPTIONS='--max-old-space-size=2048' storybook build",
    "clean": "rimraf storybook-static .turbo dist",
    "typecheck": "tsgo --noEmit",
