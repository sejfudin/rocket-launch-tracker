{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/config/**/*.ts",
    "src/config/**/*.tsx",
    "src/styles/**/*.ts",
    "src/styles/**/*.tsx",
    "src/types/**/*.d.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ]
}
