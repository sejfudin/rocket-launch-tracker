{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["RELEASE", "STAGE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "clean": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "bootstrap": {
      "cache": false
    },
    "lint": {},
    "lint:check": {
      "dependsOn": ["generate"]
    },
    "format": {},
    "format:check": {
      "dependsOn": ["generate"]
    },
    "typecheck": {
      "dependsOn": ["generate"]
    },
    "test": {},
    "check:ci": {
      "dependsOn": ["generate", "typecheck", "lint:check", "format:check"]
    },
    "generate": {
      "dependsOn": ["^generate"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "openapi:gen": {
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["ui", "utils", "config", "assets"]
        }
      },
      "ui": {
        "dependencies": {
          "allow": ["ui", "utils", "config", "assets"]
        }
      },
      "utils": {
        "dependencies": {
          "allow": ["utils", "config"]
        }
      }
    }
  },
  "noUpdateNotifier": true
}
